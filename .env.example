# =============================================================================
# LaunchKit Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: nvidia | gemini
# If unset, auto-detects: NVIDIA_API_KEY → nvidia, else GEMINI_API_KEY → gemini
LLM_PROVIDER=nvidia

# NVIDIA NIM (build.nvidia.com) — recommended for free-tier dev
# Get key: build.nvidia.com → avatar → API Keys → Generate (nvapi-...)
# Browse models: build.nvidia.com/explore/discover (filter "Free Endpoint")
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Google Gemini (optional — used when LLM_PROVIDER=gemini)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=

# Supabase anon/public key (client-side safe; read-only via RLS)
SUPABASE_ANON_KEY=

# Supabase service role key (server-side only; bypasses RLS)
# NEVER expose this in client code or commit to git
SUPABASE_SERVICE_KEY=

# GitHub Personal Access Token (repo read + contents write for README push)
# https://github.com/settings/tokens — scopes: repo (or public_repo for public repos)
GITHUB_TOKEN=

# LinkedIn API access token (optional — leave empty for manual copy flow)
# Requires w_member_social scope; v1 uses copy-to-clipboard fallback
LINKEDIN_ACCESS_TOKEN=

# Bearer token protecting all /api/v1/* routes (generate a strong random string)
LAUNCHKIT_API_SECRET=

# Local API (for scripts/pipeline.sh — optional, defaults to http://localhost:8000)
API_URL=http://localhost:8000

# Active pipeline run — set after POST /runs, used by scripts/pipeline.sh
# RUN_ID=997342eb-3448-4218-9aef-910ffb7ecc2b

# Runtime environment: development | production
# development: verbose logging, token usage printed to stdout
# production: structured logs, stricter error masking
ENVIRONMENT=development
